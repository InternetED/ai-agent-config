{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/InternetED/ai-agent-config/blob/main/Config/mcp.servers.schema.json",
  "title": "AI Agent Config MCP servers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "servers"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "servers": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/stdioServer" },
          { "$ref": "#/$defs/httpServer" }
        ]
      }
    }
  },
  "$defs": {
    "common": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "stdioServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "command"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "transport": { "const": "stdio" },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "envVars": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "uniqueItems": true
        }
      }
    },
    "httpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "url"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "transport": { "const": "http" },
        "url": { "type": "string", "pattern": "^https?://" },
        "bearerTokenEnv": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "headersFromEnv": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    }
  }
}
